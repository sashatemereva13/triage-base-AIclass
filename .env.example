LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Comma-separated model IDs available through the same provider (include LLM_MODEL to select it).
LLM_MODELS=
# Optional rates in USD per 1,000,000 tokens; set both for cost estimates.
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
# Optional per-model USD pricing, e.g. {"model-id":{"inputPer1MUsd":1,"outputPer1MUsd":3}}
LLM_MODEL_PRICING_JSON=
# Optional persistent SQLite location (defaults to data/smoke-test-runs.sqlite).
SMOKE_TEST_DB_PATH=
